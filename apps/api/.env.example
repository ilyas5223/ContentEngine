# ── Required for the standalone renderer (pnpm --filter api render) ─────────
# OpenRouter — script generation. Free models are used by default.
OPENROUTER_API_KEY=
# Optional: comma-separated override for the free-model fallback list.
# OPENROUTER_MODELS=

# Pexels — stock B-roll. Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# ElevenLabs voiceover. Omit to fall back to local Kokoro/Piper (free).
# ELEVENLABS_API_KEY=
# Whisper model for caption timings. Default: base.en
# WHISPER_MODEL=
# Point Remotion at a specific Chrome binary if the managed one won't launch.
# CHROME_EXECUTABLE=
# ── Required only for the full web app + BullMQ worker ──────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
PORT=3002
